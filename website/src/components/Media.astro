---
// Shows one image of docs/media/ on the landing page, as a figure. The alt text comes
// from the README (scripts/sync-docs.mjs lists the images in src/generated/site-data.json).
// If the image does not exist, this component shows nothing.
import data from '../generated/site-data.json';

interface Props {
  /** The file name in docs/media/, for example `login-flow.gif`. */
  file: string;
  /** A short caption. Without it, the figure has no caption. */
  caption?: string;
  /** The image size in pixels, to keep the layout stable while the image loads. */
  width?: number;
  height?: number;
}
const { file, caption, width, height } = Astro.props;

type Image = { file: string; alt: string | null };
const image = data.media.find((m: Image) => m.file === file) as Image | undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alt = image?.alt ?? file.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
---

{image && (
  <figure class="fx-media not-content">
    <a href={`${base}/media/${image.file}`}>
      <img src={`${base}/media/${image.file}`} {alt} {width} {height} loading="lazy" decoding="async" />
    </a>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

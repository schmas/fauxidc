---
// Shows the images of docs/media/ on the landing page: the login flow GIF first, then
// the other screenshots and GIFs, in README order. The captions are the alt texts of
// the README. scripts/sync-docs.mjs copies the images and lists them in
// src/generated/site-data.json. If there are no images, this component shows nothing.
import data from '../generated/site-data.json';

interface Props {
  /** `hero`: the login flow GIF. `gallery`: the other images. */
  part: 'hero' | 'gallery';
}
const { part } = Astro.props;

type Image = { file: string; alt: string | null };
const HERO = ['login-flow.gif', 'hero.gif', 'hero.png'];
// Not a screenshot: the README title graphic.
const SKIP = ['banner.svg'];

const images: Image[] = data.media.filter((m: Image) => !SKIP.includes(m.file));
const hero = HERO.map((f) => images.find((m) => m.file === f)).find(Boolean);
const others = images.filter((m) => m !== hero);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caption = (m: Image) => {
  if (m.alt) return m.alt;
  const words = m.file.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').trim();
  return words.charAt(0).toUpperCase() + words.slice(1);
};
---

{part === 'hero' && hero && (
  <div class="fx-media fx-hero not-content">
    <img src={`${base}/media/${hero.file}`} alt={caption(hero)} loading="eager" />
  </div>
)}
{part === 'gallery' && others.length > 0 && (
  <div class="fx-media fx-gallery not-content">
    {others.map((m) => (
      <figure>
        <a href={`${base}/media/${m.file}`}><img src={`${base}/media/${m.file}`} alt={caption(m)} loading="lazy" /></a>
        <figcaption>{caption(m)}</figcaption>
      </figure>
    ))}
  </div>
)}

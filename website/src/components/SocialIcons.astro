---
// The header social links, plus a GitHub star button with the star count.
// The build reads the count from the GitHub API. The page script updates it in the browser.
// Without a count (API error or rate limit), the button shows "Star" only.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const REPO = 'schmas/fauxidc';
let stars: number | null = null;
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}`, {
    headers: { accept: 'application/vnd.github+json' },
  });
  if (res.ok) stars = (await res.json()).stargazers_count ?? null;
} catch {
  // No network at build time: no count.
}
---

<a
  class="gh-stars"
  href={`https://github.com/${REPO}`}
  data-repo={REPO}
  aria-label={stars === null ? 'Star fauxidc on GitHub' : `Star fauxidc on GitHub, ${stars} stars`}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"
    ><path
      d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"></path></svg
  >
  <span>Star</span>
  <span class="gh-stars-count" hidden={stars === null}>{stars ?? ''}</span>
</a>
<Default />

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a.gh-stars')) {
    const count = link.querySelector<HTMLElement>('.gh-stars-count');
    fetch(`https://api.github.com/repos/${link.dataset.repo}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((repo) => {
        if (!count || typeof repo?.stargazers_count !== 'number') return;
        count.textContent = String(repo.stargazers_count);
        count.hidden = false;
        link.setAttribute('aria-label', `Star fauxidc on GitHub, ${repo.stargazers_count} stars`);
      })
      .catch(() => {});
  }
</script>

<style>
  .gh-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .gh-stars:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }
  .gh-stars-count {
    padding-inline-start: 0.4rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-variant-numeric: tabular-nums;
  }
  .gh-stars-count[hidden] {
    display: none;
  }
</style>

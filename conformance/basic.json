{
  "alias": "fauxidc",
  "description": "fauxidc Basic OP (static Clients)",
  "server": {
    "discoveryUrl": "https://fauxidc/conformance/.well-known/openid-configuration",
    "login_hint": "alice"
  },
  "client": {
    "client_id": "conformance-1",
    "client_secret": "conformance-secret-1"
  },
  "client2": {
    "client_id": "conformance-2",
    "client_secret": "conformance-secret-2"
  },
  "client_secret_post": {
    "client_id": "conformance-post",
    "client_secret": "conformance-secret-post"
  },
  "browser": [
    {
      "match": "https://fauxidc/conformance/authorize*",
      "tasks": [
        {
          "task": "Login",
          "match": "https://fauxidc/conformance/authorize*",
          "optional": true,
          "commands": [
            [
              "click",
              "xpath",
              "//button[@type='submit']"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "updates the placeholder during the second authorization",
          "match": "https://fauxidc/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "match": "https://fauxidc/conformance/authorize*",
              "optional": true,
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "click",
                  "xpath",
                  "//button[@type='submit']"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "updates the placeholder during the second authorization",
          "match": "https://fauxidc/conformance/authorize*",
          "tasks": [
            {
              "task": "Login",
              "match": "https://fauxidc/conformance/authorize*",
              "optional": true,
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "click",
                  "xpath",
                  "//button[@type='submit']"
                ]
              ]
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://fauxidc/conformance/authorize*",
          "tasks": [
            {
              "task": "Expect error page",
              "match": "https://fauxidc/conformance/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "redirect_uri not registered",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-redirect-uri-in-authorization-request": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://fauxidc/conformance/authorize*",
          "tasks": [
            {
              "task": "Expect error page",
              "match": "https://fauxidc/conformance/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "missing redirect_uri",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "comment": "expect an immediate error page",
          "match": "https://fauxidc/conformance/authorize*",
          "tasks": [
            {
              "task": "Expect error page",
              "match": "https://fauxidc/conformance/authorize*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "redirect_uri not registered",
                  "update-image-placeholder"
                ]
              ]
            }
          ]
        }
      ]
    }
  }
}
